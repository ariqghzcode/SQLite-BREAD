<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container">
    <div class="card mt-3">
    <div class="card-header text-center">
        <h1>SQLite BREAD (Browse, Read, Edit, Add, Delete) and Pagination</h1>
    </div>
    <div class="card-body">
    <input type="button" value="Create" onclick="window.location.href='/add'" class="btn btn-primary"><br>
    
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>No.</th>
                <th>Name</th>
                <th>Height</th>
                <th>Weight</th>
                <th>Birth Date</th>
                <th>Is Married</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
            <% rows.forEach(item => { %>
            <tr>
                <td><%= item.id %></td>
                <td><%= item.name %></td>
                <td><%= item.height %></td>
                <td><%= item.weight %></td>
                <td><%= item.birthdate %></td>
                <td><%= item.isMarried ? 'Yes' : 'Not yet' %></td>
                <td><a class="btn btn-success" href="/edit/<%= item.id %>">Update</a> <a class="btn btn-danger" href="/delete/<%= item.id %>"
                        onclick="return confirm('apakah anda yakin menghapus <%= item.id %>')">Delete</a></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
    </div>
    </div>
</body>

</html>